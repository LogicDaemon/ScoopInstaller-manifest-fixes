{
    "version": "1.1.0",
    "description": "A free, open-source high-precision scientific calculator. Built for STEM professionals, students and teachers.",
    "homepage": "https://speedcrunch.org",
    "license": "GPL-2.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://github.com/heldercorreia/speedcrunch/releases/download/v1.1.0/SpeedCrunch-1.1-windows-x64.zip",
            "hash": "39eb01472c41c10aa4fa660bff4e06a895a3b6b47a25d156bf0c642fecd4e0b9",
            "extract_dir": "SpeedCrunch-1.1-windows-x64"
        }
    },
    "pre_install": [
        "if (!(Test-Path \"$persist_dir\\SpeedCrunch.ini\")) { New-Item -Path \"$dir\\SpeedCrunch.ini\" -ItemType File -Force | Out-Null }",
        "if (!(Test-Path \"$persist_dir\\updates.ini\")) { New-Item -Path \"$dir\\updates.ini\" -ItemType File -Force | Out-Null }"
    ],
    "bin": "speedcrunch.exe",
    "shortcuts": [
        [
            "speedcrunch.exe",
            "SpeedCrunch"
        ]
    ],
    "persist": [
        "sessions",
        "SpeedCrunch.ini",
        "updates.ini"
    ],
    "checkver": {
        "github": "https://github.com/heldercorreia/speedcrunch"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/heldercorreia/speedcrunch/releases/download/v$version/SpeedCrunch-$majorVersion.$minorVersion-windows-x64.zip",
                "extract_dir": "SpeedCrunch-$majorVersion.$minorVersion-windows-x64"
            }
        }
    }
}
